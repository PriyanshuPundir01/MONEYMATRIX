# MoneyMatrix Banking Engine - Environment Variables Template
# Copy this file to '.env' and enter your actual private credentials.
# NEVER commit the actual '.env' file to GitHub or version control.

# Administrative Gateway Credentials
MONEYMATRIX_ADMIN_USER=<your_admin_username_here>
MONEYMATRIX_ADMIN_PASS=<your_strong_admin_password_here>

# Cryptographic Salt Key for Password Hashing (SHA-256)
MONEYMATRIX_SECRET_KEY=<your_random_cryptographic_salt_here>

