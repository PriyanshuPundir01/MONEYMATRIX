# MoneyMatrix Banking Engine - Environment Variables Configuration
# Copy this file to '.env' and update values for your environment.
# DO NOT commit '.env' to version control.

# Administrative Gateway Credentials
MONEYMATRIX_ADMIN_USER=admin
MONEYMATRIX_ADMIN_PASS=SecurePassword

# Cryptographic Salt Key for Password Hashing (SHA-256)
MONEYMATRIX_SECRET_KEY=ReplaceWithLongRandomSecureSecretSalt12345

